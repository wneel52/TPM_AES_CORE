`timescale 1ns/1ps

module tb_fsm_using_one_always;
    // DUT inputs
    reg clock;
    reg reset;
    reg req_0;
    reg req_1;
    // DUT outputs
    wire gnt_0;
    wire gnt_1;
    
    // init DUT
    fsm_using_one_always dut(
        .clock(clock),
        .reset(reset),
        .req_0(req_0),
        .req_1(req_1),
        .gnt_0(gnt_0),
        .gnt_1(gnt_1)
    );

    clocking cb @(posedge clock);
        default input #1step;
        input gnt_0,gnt_1,req_0,req_1,reset;
    endclocking

    // MUTUAL EXLCUSION: Never grant both
    a_mutex : assert property (@(posedge clock) disable iff (cb.reset || $isunknown({cb.gnt_0,cb.gnt_1}))
        !(cb.gnt_0 && cb.gnt_1)
    ) else $fatal(1, "Arbiter Failure: Both grants high at t=%0t", $time);

    // False high check : if gnt_0 then we expect req_0
    false_high_gnt0 : assert property (@(posedge clock) disable iff (cb.reset || $isunknown({cb.gnt_0,cb.req_0}))
        cb.gnt_0 |-> $past(cb.req_0)
    ) else $fatal(1, "gnt_0 high while req_0 low at t=%0t", $time);

    // if gnt_1 we expect req_1
    false_high_gnt1 : assert property (@(posedge clock) disable iff(cb.reset || $isunknown({cb.gnt_1,cb.req_1}))
        cb.gnt_1 |-> $past(cb.req_1)
    ) else $fatal(1,"gnt_1 high while req_1 low at t=%0t", $time);
    
    // no tailing assertion
    no_tail_0: assert property (@(posedge clock) disable iff (reset)
        (!cb.req_0) |-> (!cb.gnt_0)
    );

    no_tail_1: assert property (@(posedge clock) disable iff (reset)
        (!cb.rreq


    task tb_expect;
        input [255:0] name;
        input actual;
        input expected;
    begin 
        if (actual !== expected) begin
            $display("Failure: %0s at t=%0t actual=%b expected=%b",name, $time, actual, expected);
            $finish;
        end
        else begin
            $display("Pass: %0s at t=%0t", name, $time);
        end
    end
    endtask
    
    initial begin
        clock = 0;
        forever #5 clock = ~clock;
    end
    
    // test stimuli
    initial begin
        // init signals
        reset = 0;
        req_0 = 0;
        req_1 = 0;
        
        // dump waveforms
        $dumpfile("fsm_one.vcd");
        $dumpvars(0, tb_fsm_using_one_always);
    
        // Hold reset for a few cycle
        @(negedge clock);
        reset = 1;
        @(negedge clock);
        @(negedge clock);
        reset = 0;
        @(negedge clock);
        
        // request 0 for 2 cycles
        req_0 = 1;
        @(posedge clock); #1;
        tb_expect("no immdiate grant", gnt_0, 1'b0);
        tb_expect("gnt_1 stays low when req_0 high", gnt_1, 1'b0);
        
        // hold for one cycle
        @(posedge clock); #1;   
        tb_expect("gnt_0 high after second cycle", gnt_0, 1'b1);
        @(negedge clock);
        req_0 = 1'b0;
        
        // after following pos edge gnt_0 should fall
        @(posedge clock); #1;
        tb_expect("gnt_0 deasserted immediatley", gnt_0, 1'b0);                
        
        @(posedge clock); #1;
        tb_expect("gnt_0 desserted one cycle adter req_0 low", gnt_0, 1'b0);        


        // request 1 
        req_1 = 1;
        @(negedge clock);
        @(negedge clock);
        req_1 = 0;
        @(negedge clock);
        @(negedge clock);
        $finish;
    end
    
    // monitor on different signals
    initial begin
        $display("time   clk  rst  req0  req1 | gnt0  gnt1 | state");
        $monitor("%4t     %0b  %0b  %0b   %0b  | %0b   %0b |  %3b",$time, clock, reset, req_0, req_1, gnt_0, gnt_1, dut.state);
    end 

endmodule
